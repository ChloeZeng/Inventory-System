// SVLSG Inventory System — data model (spec v0.1, section 2)
//
// Notes:
// - "Enum-like" fields are stored as strings so the schema moves to Postgres
//   unchanged. Allowed values live in src/lib/constants.ts.
// - JSON blobs (category config, item specs, sampling plan, checklist) are
//   stored as strings and parsed in src/lib. Keeps SQLite/Postgres parity.
// - Stock balance is never stored: it is the sum of InventoryTransaction.qty.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id              Int       @id @default(autoincrement())
  name            String
  initials        String    @unique
  role            String // user | admin (admin manages users; it does not grant QC authority)
  // QC authorized: may set an inspection disposition, release or reject a lot,
  // resolve QC follow-ups and change ASL approval. Changes are audited.
  qcAuthorized    Boolean   @default(false)
  // onboarding tour on Home finished or skipped (UI preference, not audited)
  tourCompletedAt DateTime?
  active          Boolean   @default(true)
  createdAt       DateTime  @default(now())

  receiptsReceived     Receipt[]              @relation("ReceiptReceivedBy")
  qtyDiffsResolved     Receipt[]              @relation("ReceiptQtyDiffResolvedBy")
  lotsOperated         Lot[]                  @relation("LotOperator")
  lotsReleased         Lot[]                  @relation("LotReleasedBy")
  lotsRejected         Lot[]                  @relation("LotRejectedBy")
  documents            Document[]
  inspections          Inspection[]           @relation("InspectionInspectedBy")
  inspectionsConfirmed Inspection[]           @relation("InspectionConfirmedBy")
  transactions         InventoryTransaction[]
  auditLogs            AuditLog[]
}

model Location {
  id    Int    @id @default(autoincrement())
  name  String @unique
  rooms Room[]
  lots  Lot[]
}

model Room {
  id           Int                    @id @default(autoincrement())
  name         String
  locationId   Int
  location     Location               @relation(fields: [locationId], references: [id])
  transactions InventoryTransaction[]

  @@unique([locationId, name])
}

model Category {
  id         Int        @id @default(autoincrement())
  name       String     @unique
  codePrefix String     @unique // e.g. C-LID
  parentId   Int?
  parent     Category?  @relation("CategoryTree", fields: [parentId], references: [id])
  children   Category[] @relation("CategoryTree")
  testPath   String? // e.g. ansi_sampling (F.WD.003)
  // JSON: { specFields: [...], requirements: { at_receiving: [...], before_release: [...] } }
  // See src/lib/category-config.ts
  config     String     @default("{}")
  items      Item[]
}

model Supplier {
  id          Int        @id @default(autoincrement())
  name        String     @unique
  type        String // svlsg | customer_supplied
  aslApproved Boolean    @default(false)
  contactName String?
  email       String?
  phone       String?
  notes       String?
  active      Boolean    @default(true)
  createdAt   DateTime   @default(now())
  receipts    Receipt[]
  documents   Document[] // questionnaire F.QC.009, agreement F.QC.015
}

// One per item TYPE, never per batch.
model Item {
  id         Int        @id @default(autoincrement())
  code       String     @unique // auto: prefix + next number, e.g. C-LID-011
  legacyCode String? // code used in the old spreadsheet, e.g. C-Lids-010-38mm
  name       String
  categoryId Int
  category   Category   @relation(fields: [categoryId], references: [id])
  specs      String     @default("{}") // JSON of category specFields, e.g. {"size":"38mm"}
  active     Boolean    @default(true)
  createdAt  DateTime   @default(now())
  lots       Lot[]
  documents  Document[] // spec sheet lives here (type "Spec sheet")
}

// One delivery. Can contain several lots.
model Receipt {
  id                       Int        @id @default(autoincrement())
  receivingNo              String     @unique // REC-YYYY-###
  dateReceived             DateTime
  supplierId               Int
  supplier                 Supplier   @relation(fields: [supplierId], references: [id])
  supplierType             String // snapshot, editable: svlsg | customer_supplied
  poInvoiceNo              String?
  trackingNo               String?
  carrierInspectionDone    Boolean    @default(false) // F.WD.001
  segregation              String     @default("none") // organic | allergen | refrigeration | none
  dockStatus               String     @default("received") // received | rejected
  qtyMatchesPackingList    Boolean?
  qtyMatchNote             String?
  // QC sign-off on a total that does not match the packing list / PO
  qtyDiffResolution        String?
  qtyDiffResolvedById      Int?
  qtyDiffResolvedBy        User?      @relation("ReceiptQtyDiffResolvedBy", fields: [qtyDiffResolvedById], references: [id])
  qtyDiffResolvedAt        DateTime?
  quarantineStickerApplied Boolean    @default(false)
  receivedById             Int
  receivedBy               User       @relation("ReceiptReceivedBy", fields: [receivedById], references: [id])
  createdAt                DateTime   @default(now())
  lots                     Lot[]
  documents                Document[]
}

// One batch of one item.
model Lot {
  id                   Int                    @id @default(autoincrement())
  itemId               Int
  item                 Item                   @relation(fields: [itemId], references: [id])
  receiptId            Int
  receipt              Receipt                @relation(fields: [receiptId], references: [id])
  supplierBatchNo      String?
  lotNo                String?
  mfgDate              DateTime?
  expDate              DateTime?
  cases                Int
  unitsPerCase         Int
  qtyReceived          Int // default cases * unitsPerCase
  qtyOverrideReason    String? // required when qtyReceived != cases * unitsPerCase
  unitCost             Decimal?
  locationId           Int
  location             Location               @relation(fields: [locationId], references: [id])
  qcStatus             String                 @default("Quarantine") // Quarantine | Released | Rejected
  releaseStickerPlaced Boolean?
  releasedAt           DateTime?
  releasedById         Int?
  releasedBy           User?                  @relation("LotReleasedBy", fields: [releasedById], references: [id])
  rejectedAt           DateTime?
  rejectedById         Int?
  rejectedBy           User?                  @relation("LotRejectedBy", fields: [rejectedById], references: [id])
  rejectionReason      String?
  operatorId           Int
  operator             User                   @relation("LotOperator", fields: [operatorId], references: [id])
  createdAt            DateTime               @default(now())
  documents            Document[] // box label photo, COA, packing list...
  inspections          Inspection[]
  transactions         InventoryTransaction[]

  // ---- Workflow cache (src/lib/workflow.ts → refreshLotWorkflow) ----
  // Derived from the rules above and rewritten in the same transaction as every change
  // that affects them, so lists can filter, count and paginate in the database.
  // Never edited directly; the rules (completeness engine, release checks) stay authoritative.
  wfStage           String  @default("receiving") // receiving | inspection | release | failed | released | depleted | rejected
  wfInspection      Boolean @default(false) // in the inspection queue (quarantine, no confirmed inspection)
  wfInspectionDraft Boolean @default(false) // a draft inspection is waiting for QC confirmation
  wfRelease         Boolean @default(false) // in the release-review queue (confirmed inspection, or none required)
  wfReleaseBlocked  Boolean @default(false) // release requirements remain
  wfFollowup        Boolean @default(false) // open receiving / document / paperwork tasks
  wfFollowupQcOnly  Boolean @default(false) // every open follow-up task needs QC authorization
  wfOpenTasks       Int     @default(0) // open requirements, excluding the inspection itself
  wfBalance         Int     @default(0) // cached sum of transactions (the ledger stays authoritative)

  @@index([qcStatus])
  @@index([wfInspection])
  @@index([wfRelease])
  @@index([wfFollowup])
  @@index([wfStage])
}

model Document {
  id           Int       @id @default(autoincrement())
  lotId        Int?
  lot          Lot?      @relation(fields: [lotId], references: [id])
  receiptId    Int?
  receipt      Receipt?  @relation(fields: [receiptId], references: [id])
  itemId       Int?
  item         Item?     @relation(fields: [itemId], references: [id])
  supplierId   Int?
  supplier     Supplier? @relation(fields: [supplierId], references: [id])
  type         String // COA | Packing list | Invoice | Spec sheet | Photo | F.WD.001 | Other
  fileName     String // original name
  storagePath  String // relative to /uploads
  mimeType     String?
  sizeBytes    Int?
  uploadedById Int
  uploadedBy   User      @relation(fields: [uploadedById], references: [id])
  uploadedAt   DateTime  @default(now())
}

// F.WD.003. A lot has at most one draft; a confirmed ("final") inspection is what
// the completeness engine, release rules and queues look at. Drafts never count.
model Inspection {
  id                    Int       @id @default(autoincrement())
  lotId                 Int
  lot                   Lot       @relation(fields: [lotId], references: [id])
  status                String    @default("final") // draft | final
  inspectionLevel       String    @default("II")
  lotSize               Int
  codeLetter            String? // null when the category has no sampling plan
  plan                  String    @default("[]") // JSON per defect class: [{cls, aql, codeLetter, sampleSize, ac, re}]
  sampleSize            Int? // planned sample (largest of the plan)
  casesSampled          Int?
  itemsSampled          Int? // actual items inspected
  checklist             String    @default("{}") // JSON: { questionKey: { answer: "yes" | "no" | "na", defectClass? } }
  criticalDefects       Int       @default(0)
  majorDefects          Int       @default(0)
  minorDefects          Int       @default(0)
  defectNotes           String?
  comments              String?
  calculatedDisposition String? // Approved | Rejected, from the plan; null without a plan
  disposition           String? // set only when QC confirms; differs from calculated only with overrideReason
  overrideReason        String?
  inspectedById         Int // who last entered the results
  inspectedBy           User      @relation("InspectionInspectedBy", fields: [inspectedById], references: [id])
  inspectedAt           DateTime  @default(now())
  confirmedById         Int? // QC-authorized user who confirmed the disposition
  confirmedBy           User?     @relation("InspectionConfirmedBy", fields: [confirmedById], references: [id])
  confirmedAt           DateTime?

  @@index([lotId, status])
}

model InventoryTransaction {
  id                Int      @id @default(autoincrement())
  lotId             Int
  lot               Lot      @relation(fields: [lotId], references: [id])
  type              String // receive | production_use | sample | sent_to_client | damaged_defect | adjustment
  qty               Int // signed: + into stock, - out of stock
  roomId            Int?
  room              Room?    @relation(fields: [roomId], references: [id])
  productOrCustomer String?
  date              DateTime
  operatorId        Int
  operator          User     @relation(fields: [operatorId], references: [id])
  notes             String?
  // one id per submitted form, so a double-submit cannot record the same usage twice
  clientRequestId   String?  @unique
  createdAt         DateTime @default(now())

  @@index([lotId])
}

// Append-only. Never update or delete rows.
model AuditLog {
  id        Int      @id @default(autoincrement())
  userId    Int?
  user      User?    @relation(fields: [userId], references: [id])
  at        DateTime @default(now())
  action    String // create | update | delete
  tableName String
  recordId  String
  field     String?
  oldValue  String?
  newValue  String?
  reason    String?

  @@index([tableName, recordId])
}

// Sequential numbers: "REC-2026" -> last REC number used that year,
// "ITEM:C-LID" -> last item number used for that prefix.
model Counter {
  key   String @id
  value Int    @default(0)
}

// ---- ANSI/ASQ Z1.4 reference tables (seed data — QA must verify vs printed standard) ----

// Table 1: lot size -> code letter, per inspection level.
model AnsiCodeLetter {
  id              Int    @id @default(autoincrement())
  inspectionLevel String // "II"
  minLotSize      Int
  maxLotSize      Int? // null = no upper limit
  codeLetter      String

  @@unique([inspectionLevel, minLotSize])
}

// Sample size per code letter.
model AnsiSampleSize {
  codeLetter String @id
  sampleSize Int
  sortOrder  Int    @unique // A=1 ... R=16, used to follow arrows
}

// Table 2-A (single sampling, normal inspection).
// Either ac/re is set, or arrow is "up"/"down" (use first plan above/below).
model AnsiPlan {
  id         Int     @id @default(autoincrement())
  codeLetter String
  aql        String // stored as text to avoid float keys, e.g. "0.25"
  ac         Int?
  re         Int?
  arrow      String? // up | down

  @@unique([codeLetter, aql])
}
